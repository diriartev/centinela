# {{ ansible_managed }}
global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels: { infra: centinela }
rule_files: [/etc/prometheus/reglas.yml]
alerting:
  alertmanagers:
    - static_configs: [{ targets: ["{{ ip_alertmanager }}:9093"] }]
scrape_configs:
  - job_name: servidor          # node-exporter (host) + métricas de contenedores/SIEM del script de estado
    static_configs: [{ targets: ["{{ red_mon.gateway }}:9100"], labels: { instancia: srv-honey } }]
  - job_name: prometheus
    static_configs: [{ targets: ["127.0.0.1:9090"] }]
  - job_name: alertmanager
    static_configs: [{ targets: ["{{ ip_alertmanager }}:9093"] }]
  - job_name: grafana
    static_configs: [{ targets: ["{{ ip_grafana }}:3000"] }]
