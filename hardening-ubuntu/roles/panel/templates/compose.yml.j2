# {{ ansible_managed }}
name: panel
services:
  panel:
    build: { context: ./build }
    image: centinela/panel:1.0
    container_name: panel
    restart: unless-stopped
    environment:
      - ES_PASSWORD=${ES_PASSWORD}
      - ES_URL=https://{{ ip_es }}:9200
      - CORREOS_PERMITIDOS={{ correos_permitidos | join(',') }}
      - ESCUCHAR={{ ip_panel_admin }}
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    tmpfs: [/tmp]
    volumes:
      - /opt/stacks/siem/certs/ca.crt:/certs/ca.crt:ro
      - ./status:/status:ro
    mem_limit: 192m
    cpus: 0.5
    pids_limit: 128
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request,os;urllib.request.urlopen('http://'+os.environ['ESCUCHAR']+':8080/salud',timeout=4)"]
      interval: 30s
      timeout: 6s
      retries: 3
    networks:
      admin: { ipv4_address: {{ ip_panel_admin }} }
      data:  { ipv4_address: {{ ip_panel_data }} }
    logging: { driver: local, options: { max-size: "10m", max-file: "3" } }
networks:
  admin: { external: true, name: {{ red_admin.nombre }} }
  data:  { external: true, name: {{ red_data.nombre }} }
