## {{ ansible_managed }}
## Reglas de auditoría (CIS Ubuntu 22.04 + CIS Docker). Buscar con: ausearch -k <clave>

## Si una regla falla (ruta que no existe), seguir con las demás en vez de abortar
-i

## Hora del sistema
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -k cambio_hora
-a always,exit -F arch=b32 -S adjtimex,settimeofday,clock_settime -k cambio_hora
-w /etc/localtime -p wa -k cambio_hora

## Identidad
-w /etc/passwd -p wa -k identidad
-w /etc/group -p wa -k identidad
-w /etc/shadow -p wa -k identidad
-w /etc/gshadow -p wa -k identidad
-w /etc/security/opasswd -p wa -k identidad

## sudo
-w /etc/sudoers -p wa -k sudoers
-w /etc/sudoers.d/ -p wa -k sudoers
-w /var/log/sudo.log -p wa -k sudo_log

## Red
-a always,exit -F arch=b64 -S sethostname,setdomainname -k red
-w /etc/hosts -p wa -k red
-w /etc/netplan/ -p wa -k red

## MAC (AppArmor)
-w /etc/apparmor/ -p wa -k apparmor
-w /etc/apparmor.d/ -p wa -k apparmor

## Sesiones
-w /var/log/lastlog -p wa -k logins
-w /var/log/faillog -p wa -k logins

## Servicios endurecidos
-w /etc/ssh/sshd_config -p wa -k sshd
-w /etc/ssh/sshd_config.d/ -p wa -k sshd
-w /etc/knockd.conf -p wa -k knockd
-w /etc/ufw/ -p wa -k firewall
-w /etc/fail2ban/ -p wa -k firewall

## Docker (CIS Docker Benchmark 1.1.x). NO se vigila /var/lib/docker:
## en un honeypot cambia sin parar y llenaría el log de auditoría.
-w /usr/bin/dockerd -p rwxa -k docker
-w /usr/bin/containerd -p rwxa -k docker
-w /usr/bin/runc -p rwxa -k docker
-w /etc/docker/ -p wa -k docker_cfg
-w /lib/systemd/system/docker.service -p wa -k docker_cfg
-w /etc/containerd/ -p wa -k docker_cfg
-w /opt/stacks/ -p wa -k stacks
-w /etc/docker/daemon.json -p wa -k docker_cfg
-w /etc/default/docker -p wa -k docker_cfg
-w /etc/containerd/config.toml -p wa -k docker_cfg
-w /usr/bin/containerd-shim-runc-v2 -p wa -k docker
-w /usr/lib/systemd/system/docker.service -p wa -k docker_cfg
-w /usr/lib/systemd/system/docker.socket -p wa -k docker_cfg
## /run/containerd/containerd.sock NO va aquí: al arrancar aún no existe y auditctl dejaba de cargar
## el resto de reglas. Lo agrega un drop-in de containerd.service cuando el socket ya existe.

## Cron
-w /etc/crontab -p wa -k cron
-w /etc/cron.d/ -p wa -k cron
-w /etc/cron.hourly/ -p wa -k cron
-w /etc/cron.daily/ -p wa -k cron
-w /etc/cron.weekly/ -p wa -k cron
-w /etc/cron.monthly/ -p wa -k cron
-w /var/spool/cron/ -p wa -k cron

## Persistencia (lo primero que toca un intruso para quedarse). El vigía lo avisa por Telegram al instante.
-w /root/.ssh/ -p wa -k llaves_ssh
-w /home/{{ admin_usuario }}/.ssh/ -p wa -k llaves_ssh
-w /etc/pam.d/ -p wa -k pam
-w /etc/security/limits.conf -p wa -k pam
-w /etc/security/access.conf -p wa -k pam
-w /etc/ld.so.preload -p wa -k preload
-w /etc/ld.so.conf.d/ -p wa -k preload
-w /etc/systemd/system/ -p wa -k systemd
-w /usr/local/bin/ -p wa -k binarios
-w /usr/local/sbin/ -p wa -k binarios

## Módulos del kernel
-w /usr/bin/kmod -p x -k modulos
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k modulos

## Cambios de permisos por usuarios
-a always,exit -F arch=b64 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=unset -k permisos
-a always,exit -F arch=b64 -S chown,fchown,fchownat,lchown -F auid>=1000 -F auid!=unset -k permisos

## Accesos denegados
-a always,exit -F arch=b64 -S open,openat,creat,truncate,ftruncate -F exit=-EACCES -F auid>=1000 -F auid!=unset -k acceso_denegado
-a always,exit -F arch=b64 -S open,openat,creat,truncate,ftruncate -F exit=-EPERM -F auid>=1000 -F auid!=unset -k acceso_denegado

## Borrado por usuarios
-a always,exit -F arch=b64 -S unlink,unlinkat,rename,renameat -F auid>=1000 -F auid!=unset -k borrado
