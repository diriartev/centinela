# {{ ansible_managed }}
name: cfmetrics
services:
  cfmetrics:
    build: { context: ./build }
    image: centinela/cfmetrics:1.0
    container_name: cfmetrics
    restart: unless-stopped
    environment:
      - ES_PASSWORD=${ES_PASSWORD}
      - ES_URL=https://{{ ip_es }}:9200
      - CF_ZONA={{ cf_zona_id }}
      - CF_CUENTA={{ cf_cuenta_id }}
      - INTERVALO=300
    secrets: [cf_token]
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    volumes:
      - /opt/stacks/siem/certs/ca.crt:/certs/ca.crt:ro
      - ./estado:/estado
    # Sano = recolectó en los últimos 15 min (el ciclo es de 5 min)
    healthcheck:
      test: ["CMD", "python3", "-c", "import os,time,sys;sys.exit(0 if time.time()-os.path.getmtime('/estado/estado.json')<900 else 1)"]
      interval: 60s
      timeout: 5s
      retries: 3
      start_period: 120s
    mem_limit: 128m
    cpus: 0.25
    pids_limit: 64
    networks:
      edge: { ipv4_address: {{ ip_cfmetrics_edge }} }
      data: { ipv4_address: {{ ip_cfmetrics_data }} }
    logging: { driver: local, options: { max-size: "5m", max-file: "3" } }
secrets:
  cf_token: { file: ./secrets/cf_token }
networks:
  edge: { external: true, name: {{ red_edge.nombre }} }
  data: { external: true, name: {{ red_data.nombre }} }
