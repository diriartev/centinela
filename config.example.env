# Copia este archivo a config.env (está en .gitignore) y completa tus datos.
# Ninguno de estos valores es una contraseña, pero tampoco hace falta publicarlos.
export DOMINIO="example.com"            # tu dominio en Cloudflare (la web señuelo vive en el apex y en www)
export CF_ACCOUNT_ID="<id de la cuenta de Cloudflare>"
export CF_ZONE_ID="<id de la zona del dominio>"
export CF_TEAM="<nombre del equipo de Zero Trust>"      # <team>.cloudflareaccess.com
export CF_APP_NAME="Centinela"          # nombre de la aplicación de Cloudflare Access
export CF_POLICY_ID="<id de la política de Access que lista los correos permitidos>"
export ADMIN_EMAIL="admin@example.com"  # el correo del administrador (nunca se quita del acceso)
